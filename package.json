{
  "name": "themebooth",
  "version": "0.1.0",
  "description": "Create syntax themes once, publish to VS Code, Notepad++, and Zed",
  "main": "dist/index.js",
  "bin": {
    "themebooth": "dist/bin/themebooth.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kittender/themebooth.git"
  },
  "homepage": "https://github.com/kittender/themebooth",
  "bugs": {
    "url": "https://github.com/kittender/themebooth/issues"
  },
  "scripts": {
    "build": "tsc && mkdir -p dist/templates/presets && cp -r src/templates/presets/*.json dist/templates/presets/",
    "test": "node test.js",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build && npm run test",
    "postinstall": "node -e \"console.log('\\n✅ themebooth installed! Run: themebooth init my-theme\\n')\""
  },
  "keywords": [
    "syntax",
    "highlighting",
    "highlight",
    "theme",
    "develop",
    "grammar",
    "code",
    "colors",
    "color"
  ],
  "author": "Kittender",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "chokidar": "^3.5.3",
    "color": "^4.2.3",
    "commander": "^11.1.0",
    "express": "^4.18.2",
    "ws": "^8.14.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/color": "^3.0.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.6",
    "@types/ws": "^8.18.1",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.3.3"
  }
}
